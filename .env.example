# 모델 가중치 (둘 다 있으면 두 모델 통합으로 판정. 없으면 /api/inspections 가 503)
BLOCK_WEIGHTS=weights/v4_best.pt
SCENE_WEIGHTS=weights/scene_v1_best.pt
# (예전) 단일 모델 가중치. 위 두 개가 없을 때만 씀
WEIGHTS_PATH=weights/best.pt
# FE 개발 서버·배포 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173
# Supabase (비워두면 서버 메모리에만 저장, 재시작하면 사라짐)
# 테이블 만들기: docs/supabase.sql 을 Supabase SQL Editor에서 실행
# KEY는 서버 전용 service_role 키. 브라우저(프론트) 코드에 넣지 말 것
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=inspections
